#!name=一汽大众去广告原生版
#!desc=参考喜马拉雅语法，使用纯内置JQ处理，无需下载外部脚本。
#!author=Custom
#!icon=https://raw.githubusercontent.com/luestr/IconHub/master/App/FawVw.png

[MITM]
hostname = oneapp-api.faw-vw.com

[Script]
# 开屏广告 - 强制清空数据列表并返回成功状态
http-response ^https?:\/\/oneapp-api\.faw-vw\.com\/content\/booth\/getBoothList\/v1\?.*showPositionCode=VWAPP_(ICE|MEB)_(OPEN_SCREEN_ADS|CAR_ZHIHU_COLLEGE) jsonjq-response-body '.data.list = [] | .returnStatus = "SUCCEED"' tag=开屏屏蔽

# 首页浮窗屏蔽
http-response ^https?:\/\/oneapp-api\.faw-vw\.com\/content\/booth\/getBoothList\/v1\?.*showPositionCode=VWAPP_HOME_BUOY jsonjq-response-body '.data.list = [] | .returnStatus = "SUCCEED"' tag=浮窗屏蔽

# 首页Banner与金刚位屏蔽
http-response ^https?:\/\/oneapp-api\.faw-vw\.com\/content\/booth\/getBoothList\/v1\?.*showPositionCode=VWAPP_(ICE|MEB)_HOME_(OWNER_BANNER|PROSPECTS_BANNER|CUSTOM_BANNER|KONGO|CUSTOM_KONGO) jsonjq-response-body '.data.list = [] | .returnStatus = "SUCCEED"' tag=首页清爽

# 内容流清空 (广场、动态、推荐等)
http-response ^https?:\/\/oneapp-api\.faw-vw\.com\/content\/(customize\/getCustomizePageName|recommend\/getRecommendInfoFlows|activity\/getSquareActivityList|theme\/getThemeList|post\/getPostsByTags|evaluate\/getEvaluateCards)\/v1\?.* jsonjq-response-body '.data = [] | .returnStatus = "SUCCEED"' tag=内容清空
