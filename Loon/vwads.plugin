#!name=一汽大众去广告精准版
#!desc=屏蔽开屏广告及首页推广，无需下载外部脚本，直接本地解析。
#!author=Custom
#!icon=https://raw.githubusercontent.com/luestr/IconHub/master/App/FawVw.png

[MITM]
hostname = oneapp-api.faw-vw.com

[Script]
# 屏蔽开屏广告
http-response ^https?:\/\/oneapp-api\.faw-vw\.com\/content\/booth\/getBoothList\/v1\?.*showPositionCode=VWAPP_(ICE|MEB)_(OPEN_SCREEN_ADS|CAR_ZHIHU_COLLEGE) jsonjq-response-body '.data.list = [] | .returnStatus = "SUCCEED"' tag=开屏屏蔽

# 屏蔽首页浮窗
http-response ^https?:\/\/oneapp-api\.faw-vw\.com\/content\/booth\/getBoothList\/v1\?.*showPositionCode=VWAPP_HOME_BUOY jsonjq-response-body '.data.list = [] | .returnStatus = "SUCCEED"' tag=浮窗屏蔽

# 屏蔽首页横幅及金刚位
http-response ^https?:\/\/oneapp-api\.faw-vw\.com\/content\/booth\/getBoothList\/v1\?.*showPositionCode=VWAPP_(ICE|MEB)_HOME_(OWNER_BANNER|PROSPECTS_BANNER|CUSTOM_BANNER|KONGO|CUSTOM_KONGO) jsonjq-response-body '.data.list = [] | .returnStatus = "SUCCEED"' tag=首页清理

# 屏蔽搜索提示
http-response ^https?:\/\/oneapp-api\.faw-vw\.com\/search\/firstPage\/getPromptList\/v1\?.* jsonjq-response-body '.data = [] | .returnStatus = "SUCCEED"' tag=搜索屏蔽

# 屏蔽其他内容配置
http-response ^https?:\/\/oneapp-api\.faw-vw\.com\/content\/(customize\/getCustomizePageName|recommend\/getRecommendInfoFlows|activity\/getSquareActivityList|theme\/getThemeList|post\/getPostsByTags|evaluate\/getEvaluateCards)\/v1\?.* jsonjq-response-body '.data = [] | .returnStatus = "SUCCEED"' tag=内容清理
